# Veriq environment. Copy to .env (git-ignored) and fill in. Never commit real values:
# provider URLs usually contain API keys. Services and where to get them: docs/SERVICES.md.

# ─── Engine (backend/crates/server) ─────────────────────────────────────────────
# Execution RPC providers, label=url pairs. Need eth_getProof at finalized blocks
# and ideally EIP-1898 blockHash params. Use at least 2 independent providers;
# the startup probe excludes any on the wrong chain or without eth_getProof.
# Replace the first URL with your own keyed provider (e.g. Alchemy); PublicNode is keyless.
VERIQ_PROVIDERS=a=https://<sepolia-rpc-with-eth_getProof>,publicnode=https://ethereum-sepolia-rpc.publicnode.com
# Where the trusted state root comes from: helios | fixture | dev-untrusted
#   helios        verified receipts; needs a build with --features helios
#   fixture       offline/tests; root from VERIQ_FIXTURE_* below
#   dev-untrusted DEV ONLY; root from the first provider, receipts are "unverified"
VERIQ_ROOT_SOURCE=helios
# Must be 1 to allow VERIQ_ROOT_SOURCE=dev-untrusted. Leave 0 otherwise.
VERIQ_DEV_ALLOW_UNTRUSTED_ROOT=0
# Optional, dev mode only: the RPC whose finalized block is the untrusted root
# (default: the first VERIQ_PROVIDERS URL). The test scripts set it themselves.
VERIQ_DEV_ROOT_RPC=
# Optional: directory holding sepolia.toml and checkpoint.toml (default ./config).
VERIQ_CONFIG_DIR=
# Optional: log filter, e.g. veriq_server=debug (default veriq_server=info).
# debug also logs per-attempt fetch_ms / verify_us timings (no addresses, no URLs).
RUST_LOG=
# Optional: 1 = serve repeat reads at the same finalized block from already-verified
# values (no provider call; receipt carries a VERIFIED_CACHE_HIT warning). Default off,
# so the attack demo and scripts/e2e.sh always reach the providers.
VERIQ_VERIFIED_CACHE=

# Seconds between re-probes of providers the startup probe marked ineligible
# (wrong chain or no eth_getProof). Default 300; 0 turns re-probing off.
VERIQ_REPROBE_SECS=

# Seconds between background refreshes of the cached finalized root. Reads reuse the
# cached root while it is at most 3 intervals old. Default 12 (one slot); 0 = no cache.
VERIQ_ROOT_REFRESH_SECS=

# Optional: bind address and port (default 127.0.0.1 and 8547). Only for hosting behind a
# proxy (e.g. Render sets PORT and needs VERIQ_HOST=0.0.0.0); the engine then answers anyone
# who can reach it, using your provider keys.
VERIQ_HOST=
PORT=

# ─── Receipt storage (PostgreSQL) ───────────────────────────────────────────────
# Set for receipts that survive restart (newest 5,000). Leave empty to keep receipts
# in memory only (newest 500, lost on restart). A DATABASE_URL that is set but unreachable
# stops the engine at startup. Docker Compose requires both values; its postgres service
# listens on 127.0.0.1:5432, database proofroute, user veriq:
#   DATABASE_URL=postgres://veriq:<POSTGRES_PASSWORD>@127.0.0.1:5432/proofroute
# Hosted PostgreSQL (e.g. Neon): remove channel_binding=require from the copied URL; the
# engine's driver (SQLx) does not support it. sslmode=require still encrypts.
DATABASE_URL=
POSTGRES_PASSWORD=
# Optional: a DEDICATED test database; its receipts table is truncated by the test.
TEST_DATABASE_URL=

# ─── Helios light client (VERIQ_ROOT_SOURCE=helios) ─────────────────────────────
# Sepolia beacon API that serves the light-client endpoints.
# The public Nimbus endpoint below is the one the recorded runs used.
HELIOS_CONSENSUS_RPC=https://unstable.sepolia.beacon-api.nimbus.team
# Optional override of config/checkpoint.toml: a recent finalized beacon block root,
# taken from a DIFFERENT source than HELIOS_CONSENSUS_RPC.
HELIOS_CHECKPOINT=
# Optional override: where that checkpoint came from (recorded in every receipt).
HELIOS_CHECKPOINT_SOURCE=
# Optional: Helios data directory (default: veriq-helios in the OS temp folder).
HELIOS_DATA_DIR=
# Optional: execution RPC Helios uses (default: the first VERIQ_PROVIDERS URL).
# Also used by the fixture capture tool (cargo run -p veriq-server --bin capture).
EXEC_RPC=

# ─── Offline fixture root (VERIQ_ROOT_SOURCE=fixture) ───────────────────────────
# Use a Helios-finalized block, never a provider-only root (config/checkpoint.toml has one).
VERIQ_FIXTURE_NUMBER=
VERIQ_FIXTURE_HASH=
VERIQ_FIXTURE_STATE_ROOT=

# ─── Demo attacker (crates/malicious-rpc, demo only) ───────────────────────────
# Honest upstream the attacker forwards to before tampering.
UPSTREAM_RPC=
# Optional bind address (default 127.0.0.1:9545).
MALICIOUS_RPC_BIND=

# ─── Dashboard (frontend/dashboard) ─────────────────────────────────────────────
# Optional: where the dev server proxies /engine and /attacker (defaults below).
VERIQ_ENGINE_URL=http://127.0.0.1:8547
VERIQ_ATTACKER_URL=http://127.0.0.1:9545
# Optional: base URLs the browser uses (default: the same-origin proxies /engine, /attacker).
VITE_ENGINE_URL=
VITE_ATTACKER_URL=
# Optional: where the Attack Lab sends its demo-only breaker reset (default http://127.0.0.1:8547).
VITE_ENGINE_ADMIN_URL=
# Private reads (Anon-RPC): `off` keeps every read on the direct engine path. Default: on (Nox).
VITE_ANON=
# Providers the browser asks through Nox: label=https://url,label2=https://url2. Empty = PublicNode.
VITE_ANON_PROVIDERS=
# Helios in the browser, synced through Nox (S4). `off` = reads use the engine's root alone.
VITE_BROWSER_LIGHT_CLIENT=
# Beacon API for browser Helios, reached through Nox. Empty = https://lodestar-sepolia.chainsafe.io
# (Nimbus serves a Cloudflare Origin certificate that browsers and Nox reject).
VITE_HELIOS_CONSENSUS_RPC=
# checkpointz giving the current finalized checkpoint; must be another operator than the beacon
# API. Empty = https://checkpoint-sync.sepolia.ethpandaops.io
VITE_HELIOS_CHECKPOINT_SOURCE=
# Check every proof in the browser too (S5, the engine's verifier as WebAssembly). With browser
# Helios synced, reads keep working while the engine is down (local-only receipts).
# `off` = the engine verifies alone.
VITE_BROWSER_VERIFIER=

# ─── Scripts (scripts/attack-check.sh, scripts/e2e.sh) ──────────────────────────
# Optional: helios | dev. Same as passing --helios / --dev. Default: helios when
# HELIOS_CONSENSUS_RPC is set.
VERIQ_CHECK_ROOT=
# Optional: Sepolia address to read in demos and checks (default 0xc497…6558, which has a balance).
VERIQ_DEMO_ADDRESS=
# Deployed DemoStorage (smart-contract/DEPLOYED.md): slot 0 proves to 42, balances[deployer] to 7.
VERIQ_DEMO_CONTRACT=0x1242C562946C926a6d0012Acb54D9413A54A1CA4
# Optional, for another DemoStorage deployment: the mapping key e2e.sh reads and its value.
VERIQ_DEMO_BALANCE_ACCOUNT=
VERIQ_DEMO_BALANCE=
# Honest RPC the attack check pairs with the attacker (default UPSTREAM_RPC). Must not be
# the attacker, and must pass the probe (Sepolia + eth_getProof), or the check stops.
VERIQ_HONEST_RPC=
# Optional: python interpreter for attack-check.sh's JSON parsing.
PYTHON_BIN=
# Set to 1 to run tests that need the network (CI leaves it unset).
VERIQ_LIVE=

# ─── Contracts (smart-contract/script/Deploy.s.sol) ─────────────────────────────
SEPOLIA_RPC_URL=
# Throwaway deployer key with Sepolia test ETH. Never reuse a real key.
DEPLOYER_PRIVATE_KEY=
# Optional: verify the contract on Etherscan (forge --verify reads it).
ETHERSCAN_API_KEY=

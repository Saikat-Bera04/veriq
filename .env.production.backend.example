# ==============================================================================
# VeriQ Engine — Production Environment Configuration Template
# ==============================================================================
# Apply these variables to your cloud hosting platform (e.g. Render, Railway, Fly.io)
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# Core Service Configuration
VERIQ_ENV=production
VERIQ_NETWORK=sepolia
VERIQ_HOST=0.0.0.0
PORT=8547
VERIQ_CONFIG_DIR=./config

# Root Source (MUST be 'helios' in production; 'dev-untrusted' fails closed in production)
VERIQ_ROOT_SOURCE=helios
HELIOS_DATA_DIR=/data/helios

# Consensus Layer Beacon API (Required for Helios light client)
# Examples:
# - ChainSafe Lodestar Sepolia: https://lodestar-sepolia.chainsafe.io
# - Nimbus Sepolia Beacon API:  https://unstable.sepolia.beacon-api.nimbus.team
HELIOS_CONSENSUS_RPC=https://lodestar-sepolia.chainsafe.io

# Execution Layer RPC Providers (Comma-separated label=url pairs)
# Always configure at least two reliable providers for automatic failover.
# Example: publicnode=https://ethereum-sepolia-rpc.publicnode.com,alchemy=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
VERIQ_PROVIDERS=publicnode=https://ethereum-sepolia-rpc.publicnode.com,infura=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Managed PostgreSQL Database Connection String
# Must include sslmode=require for secure cloud transport.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://veriq:CHANGE_ME_PASSWORD@veriq-postgres.render.com:5432/proofroute?sslmode=require

# CORS Allowed Origins (Comma-separated list of production frontend domains)
VERIQ_ALLOWED_ORIGINS=https://veriq.vercel.app,https://veriq-dashboard.vercel.app

# Performance & Caching
VERIQ_VERIFIED_CACHE=1
VERIQ_ROOT_REFRESH_SECS=12
VERIQ_REPROBE_SECS=300

# Logging & Telemetry (Structured tracing)
RUST_LOG=info,veriq_server=info,veriq_router=info,veriq_light_client=info


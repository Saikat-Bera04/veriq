{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@kirann_out/veriq-client": ["src/index.ts"],
      "@kirann_out/veriq-client/react": ["src/react/index.ts"],
      "veriq-client": ["src/index.ts"],
      "veriq-client/react": ["src/react/index.ts"]
    }
  },
  "include": ["src", "bin", "examples", "test", "tsup.config.ts", "vitest.config.ts"]
}

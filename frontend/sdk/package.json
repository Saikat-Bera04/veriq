{
  "name": "veriq-client",
  "version": "0.1.2",
  "description": "Verified Ethereum reads, with a receipt for every answer.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "source": "./src/react/index.ts",
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./styles.css": {
      "source": "./src/react/styles.css",
      "default": "./dist/styles.css"
    },
    "./verifier.wasm": "./wasm/veriq_verifier.wasm",
    "./package.json": "./package.json"
  },
  "bin": {
    "veriq": "./dist/bin/veriq.js"
  },
  "files": [
    "dist",
    "wasm",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && node scripts/size.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm run lint && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "react": ">=18",
    "viem": "^2.21.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "happy-dom": "^15.11.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "viem": "^2.57.11",
    "vitest": "^2.1.9"
  }
}

# ==============================================================================
# VeriQ Dashboard — Production Environment Configuration Template
# ==============================================================================
# Apply these variables to your frontend hosting platform (e.g. Vercel)
# In Vite, only variables prefixed with VITE_ are embedded into the client bundle.
# NEVER PUT PRIVATE KEYS, DATABASE PASSWORDS, OR API SECRETS HERE.
# ==============================================================================

# Backend Engine Endpoint
# When using Vercel's rewrite proxy (configured in vercel.json), set this to '/engine'
# to keep all API traffic same-origin and avoid browser CORS preflights.
# Alternatively, set to full HTTPS domain if calling directly: https://veriq-cloud.onrender.com
VITE_ENGINE_URL=/engine

# Anonymizing Transport (Anon-RPC mixnet routing via Nox / WebRTC)
# 'on' routes provider calls through mixnet; 'off' calls direct.
VITE_ANON=on

# Client-Side WASM Verifier
# 'on' loads the WebAssembly Merkle verifier in browser for dual-verification.
VITE_BROWSER_VERIFIER=on

# Browser-Native Helios Light Client
# 'on' enables in-browser consensus verification over Nox.
VITE_BROWSER_HELIOS=on

# Optional Demo Contract Address Override
VITE_DEMO_CONTRACT_ADDRESS=0x1242C562946C926a6d0012Acb54D9413A54A1CA4


# syntax=docker/dockerfile:1
# Veriq engine with the Helios light client.
FROM rust:1.94.1-bookworm AS build
WORKDIR /src/backend
COPY backend/Cargo.toml backend/Cargo.lock ./
COPY backend/crates ./crates
COPY backend/tests ./tests
ENV CARGO_BUILD_JOBS=4
RUN cargo build --release --locked -p veriq-server --features helios --bin veriq-server

FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /src/backend/target/release/veriq-server /usr/local/bin/veriq-server
COPY backend/config ./config
COPY docker/engine-entrypoint.sh /usr/local/bin/engine-entrypoint.sh
ENV HELIOS_DATA_DIR=/data/helios
VOLUME /data
HEALTHCHECK --interval=10s --timeout=3s --start-period=90s --retries=6 \
  CMD sh -c 'curl -sf "http://127.0.0.1:${PORT:-8547}/health"' | grep -q '"status":"ok"'
ENTRYPOINT ["/usr/local/bin/engine-entrypoint.sh"]
